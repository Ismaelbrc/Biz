# Chave da API Anthropic, usada para qualificar anúncios ambíguos (opcional).
# Sem ela, o agente usa apenas as regras heurísticas em leadgen/qualify.py.
ANTHROPIC_API_KEY=

# User-Agent usado pelo navegador headless (Playwright) ao acessar o OLX.
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
